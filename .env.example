# ── Ports ────────────────────────────────────────────────────────────────────
# Backend API port — read by start-api.sh, vite.config.js proxy, and batch_gen_phrase.py
API_PORT=8010

# Frontend dev server port — read by vite.config.js (server.port)
# Must match CB_FRONTEND_URL below so the OAuth callback lands on the right origin.
DEV_PORT=5173

# ── FastAPI / OAuth ───────────────────────────────────────────────────────────
# Google OAuth — reuse the zinets_vis OAuth client from Google Cloud Console
# (APIs & Services → Credentials). Local files in zinets_vis only contain
# placeholders; copy the real values from the Console or your deployed server.
CB_GOOGLE_CLIENT_ID=
CB_GOOGLE_CLIENT_SECRET=

# OAuth callback sent to the backend; must be an authorized redirect URI in
# the Google Cloud Console. Default matches the API_PORT above.
CB_GOOGLE_REDIRECT_URI=http://localhost:8010/api/auth/google/callback

# Where the backend redirects the browser after OAuth completes.
# Must match DEV_PORT above.
CB_FRONTEND_URL=http://localhost:5173/cb-zinets/

# Signs the OAuth state cookie. Unset → random per boot (fine for dev).
CB_SESSION_SECRET=
